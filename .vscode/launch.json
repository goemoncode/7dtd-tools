{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Deno: Debug TS File",
      "runtimeExecutable": "deno",
      "runtimeArgs": ["run", "--allow-all", "--env-file=.env.local"],
      "program": "${file}",
      "args": ["workstation"],
      "console": "integratedTerminal"
    }
  ]
}
